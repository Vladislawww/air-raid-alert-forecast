import pandas as pd

df = pd.read_csv("data/official_data_uk.csv")

kyiv = df[df["oblast"] == "м. Київ"].copy()


# 1. спочатку перетворюємо час
df["started_at"] = pd.to_datetime(df["started_at"], utc=True)
df["finished_at"] = pd.to_datetime(df["finished_at"], utc=True)

# 2. і тільки потім беремо Київ
kyiv = df[df["oblast"] == "м. Київ"].copy()

# 3. тривалість у хвилинах
kyiv["duration_min"] = (kyiv["finished_at"] - kyiv["started_at"]).dt.total_seconds() / 60

print(kyiv["duration_min"].describe())
print("Пропуски finished_at:", kyiv["finished_at"].isna().sum())
print("Тривалість <= 0:", (kyiv["duration_min"] <= 0).sum())
print("Тривалість > 12 год:", (kyiv["duration_min"] > 12 * 60).sum())